# FreeTAKServer environment for the systemd service.
# install-ubuntu.sh writes /etc/freetakserver/fts.env from this file and fills
# in the address and secrets. Env vars override FTSConfig.yaml.

# Address handed to clients in data packages and certs. Must be the droplet's
# public IP (or a DNS name pointing at it), never 127.0.0.1.
FTS_DP_ADDRESS=__PUBLIC_IP__
FTS_USER_ADDRESS=__PUBLIC_IP__

# Secrets. The upstream defaults are public, so these are generated per install.
FTS_SECRET_KEY=__SECRET_KEY__
FTS_FED_PASSWORD=__FED_PASSWORD__
FTS_CLIENT_CERT_PASSWORD=__CLIENT_CERT_PASSWORD__
FTS_WEBSOCKET_KEY=__WEBSOCKET_KEY__

FTS_PERSISTENCE_PATH=/opt/fts
FTS_CONNECTION_MESSAGE="Welcome to FreeTAKServer"

# Ports
FTS_COT_PORT=8087
FTS_SSLCOT_PORT=8089
FTS_FED_PORT=9000
# REST API binds to all interfaces; keep 19023 closed in the firewall
FTS_API_PORT=19023
FTS_API_ADDRESS=0.0.0.0

FTS_COT_TO_DB=True
FTS_LOG_LEVEL=info
